.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Node: solo se usa para herramientas y pruebas, nunca en tiempo de ejecución
node_modules/
npm-debug.log*

# Python de las herramientas
__pycache__/
*.pyc
.venv/
